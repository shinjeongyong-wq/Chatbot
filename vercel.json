{
    "outputDirectory": ".",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        }
    ],
    "functions": {
        "api/chat.js": {
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "crons": [
        {
            "path": "/api/analyze-questions",
            "schedule": "0 15 * * *"
        }
    ]
}